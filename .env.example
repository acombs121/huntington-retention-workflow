# =====================================================================
# GCP Environment & Application Configuration (.env.example)
# Copy this file to .env and replace placeholders with your actual values.
# DO NOT commit .env to version control!
# =====================================================================

# --- 1. SHARED / CORE CONFIGURATION ---
GCP_PROJECT="hban-wealth-innovation"
GCP_REGION="us-central1"
APP_NAME="huntington-horizon"
GEMINI_MODEL="gemini-3.7-flash"

# --- 2. LOCAL DEVELOPMENT CONFIGURATION ---
APP_ENV="local"
LOCAL_HOST="127.0.0.1"
LOCAL_PORT="8080"
DEBUG="true"
IAP_ENABLED_LOCAL="false"

# --- 3. PRODUCTION / GOOGLE CLOUD RUN CONFIGURATION ---
PROD_ENV="production"
SERVICE_ACCOUNT_NAME="huntington-horizon-sa"
IAP_ALLOWED_MEMBER=""
IAP_ALLOWED_DOMAINS="google.com,huntington.com"

# Cloud Run Scaling & Resources
MIN_INSTANCES=0
MAX_INSTANCES=3
MEMORY="2Gi"
CPU="1"
REQUIRED_SECRETS=""
